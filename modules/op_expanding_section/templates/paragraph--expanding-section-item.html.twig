<div class="toggle-section">
	<h3>
		<button type="button" class="toggle-trigger" id="toggle-trigger-{{ paragraph.id() }}" aria-expanded="false" aria-controls="toggle-panel-{{ paragraph.id() }}">
			<span class="toggle-label">{{ content.field_orbit_pt_section_title.0 }}</span>
			<span class="toggle-icon" aria-hidden="true">
				<svg viewbox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<polyline points="6 9 12 15 18 9"></polyline>
				</svg>
			</span>
		</button>
	</h3>
	<div class="toggle-panel-outer" id="toggle-panel-outer-{{ paragraph.id() }}" data-open="false">
		<div class="toggle-panel-inner">
			<div class="toggle-panel-content" id="toggle-panel-{{ paragraph.id() }}" role="region" aria-labelledby="toggle-trigger-{{ paragraph.id() }}">
				{{ content.field_orbit_pt_section_text.0 }}
			</div>
		</div>
	</div>
</div>
