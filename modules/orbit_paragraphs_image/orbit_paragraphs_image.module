<?php

/**
 * @file
 */

declare(strict_types=1);

/**
 * Implements hook_theme().
 *
 * Https://www.drupal.org/docs/theming-drupal/twig-in-drupal/create-custom-twig-templates-for-custom-module.
 */
function orbit_paragraphs_image_theme($existing, $type, $theme, $path): array {
  return [
    'paragraph__orbit_paragraphs_inline_image' => [
      'render element' => 'elements',
      'base hook' => 'paragraph',
    ],
  ];
}
