<?php

/**
 * @file
 * Install, update, and uninstall functions for Orbit Paragraphs.
 */

declare(strict_types=1);

use Drupal\Core\Url;
use Drupal\node\Entity\Node;

/**
 * Implements hook_install().
 */
function orbit_paragraphs_install(): void {
  orbit_paragraphs_create_default_categories();
}

/**
 * Implements hook_uninstall().
 */
function orbit_paragraphs_uninstall($is_syncing) {
  $config = \Drupal::configFactory()
    ->getEditable('orbit_paragraphs.settings');

  // Delete dummy page.
  $node = Node::load($config->get('dummy_page_nid'));
  $node->delete();

  // Delete/remove any config settings.
  $config = \Drupal::configFactory()
    ->getEditable('orbit_paragraphs.settings')
    ->delete();
}

/**
 * Removes invalid Field Group component third-party settings.
 */
function orbit_paragraphs_update_12001(): void {
  orbit_paragraphs_remove_component_field_group_settings();
}

/**
 * Removes component-level field_group settings from paragraph form displays.
 */
function orbit_paragraphs_remove_component_field_group_settings(): void {
  $storage = \Drupal::entityTypeManager()->getStorage('entity_form_display');

  foreach ($storage->loadMultiple() as $form_display) {
    if ($form_display->get('targetEntityType') !== 'paragraph') {
      continue;
    }

    $changed = FALSE;
    foreach ($form_display->getComponents() as $component_name => $component) {
      if (!isset($component['third_party_settings']['field_group'])) {
        continue;
      }

      unset($component['third_party_settings']['field_group']);

      if ($component['third_party_settings'] === []) {
        unset($component['third_party_settings']);
      }

      $form_display->setComponent($component_name, $component);
      $changed = TRUE;
    }

    if ($changed) {
      $form_display->save();
    }
  }
}

/**
 * Creates the default Orbit paragraph categories when they do not exist.
 *
 * @return string[]
 *   The labels of the categories that were created.
 */
function orbit_paragraphs_create_default_categories(): array {

  $storage = \Drupal::entityTypeManager()->getStorage('paragraphs_category');
  $created = [];

  foreach (orbit_paragraphs_default_categories() as $weight => $category) {
    if ($storage->load($category['id'])) {
      continue;
    }

    $storage->create([
      'id' => $category['id'],
      'label' => $category['label'],
      'weight' => $weight,
    ])->save();
    $created[] = $category['label'];
  }

  return $created;
}

/**
 * Returns the default Orbit paragraph categories.
 *
 * @return array<int, array{id: string, label: string}>
 *   The default categories keyed in display order.
 */
function orbit_paragraphs_default_categories(): array {
  return [
    [
      'id' => 'news',
      'label' => 'News',
    ],
    [
      'id' => 'cta',
      'label' => 'CTA',
    ],
    [
      'id' => 'media',
      'label' => 'Media',
    ],
    [
      'id' => 'text',
      'label' => 'Text',
    ],
  ];
}